# Auto-normalize line endings for cross-platform dev (Windows ↔ macOS)
* text=auto eol=lf

# Force LF for all source files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.cfg text eol=lf
*.lock text eol=lf

# Binary files — don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.ipa binary
